    "express-rate-limit": "latest",
    "express-validator": "latest",
    "i18next": "latest",
    "jsonwebtoken": "latest",
    "multer": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/bcrypt": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/i18next": "latest",
    "@types/jest": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "@types/ws": "^8.18.1",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "jest": "latest",
    "prisma": "5.22.0",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"

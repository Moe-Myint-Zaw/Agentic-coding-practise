# API Configuration for Expo Go on Physical Devices
# When running on Expo Go with a physical device, set this to your development machine's LAN IP address
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1
# 
# To find your LAN IP:
# - Windows: Run `ipconfig` and look for IPv4 Address under your network adapter
# - Mac: Run `ifconfig` and look for inet under en0 or en1
# - Linux: Run `ip addr` and look for inet under your network interface
#
# Make sure your device and development machine are on the same network
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
